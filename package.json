{
  "name": "maite-text-to-cad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:webpack": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "prepare:cad": "node scripts/prepare-cad.mjs",
    "postinstall": "npm run prepare:cad",
    "test": "node --experimental-strip-types --test tests/schema.test.ts tests/scene.test.ts tests/characters.test.ts tests/live-chat.test.ts tests/novel.test.ts tests/usage.test.ts tests/account.test.ts tests/deferred-billing.test.ts tests/generation-result.test.ts tests/identity-gallery.test.ts tests/performance-read.test.ts tests/image-cache.test.ts tests/profile-photo.test.ts tests/persistent-images.test.ts tests/checkins.test.ts tests/checkins-api.test.ts tests/local-checkins.test.ts tests/visual-scene.test.ts tests/scene-selection.test.ts tests/rewards.test.ts tests/analytics.test.ts",
    "test:e2e": "playwright test",
    "test:accounts": "playwright test --config playwright.accounts.config.ts",
    "mobile:dev": "vite apps/mobile --config apps/mobile/vite.config.ts",
    "mobile:build": "vite build apps/mobile --config apps/mobile/vite.config.ts",
    "mobile:sync": "npm run mobile:build && cd apps/mobile && cap sync android",
    "mobile:open": "cd apps/mobile && cap open android",
    "android:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1 -Configuration Debug",
    "android:aab": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1 -Configuration Release",
    "test:mobile": "playwright test --config playwright.mobile.config.ts"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.4.1",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capgo/native-purchases": "^8.9.16",
    "@supabase/supabase-js": "^2.119.0",
    "lucide-react": "^0.577.0",
    "next": "16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "replicad": "1.2.1",
    "replicad-opencascadejs": "1.2.1",
    "sharp": "^0.35.5",
    "three": "^0.183.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.183.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
