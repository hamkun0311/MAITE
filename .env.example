OPENAI_API_KEY=
# auto preserves base-URL routing. Use vnai for VNAI Pro or direct for OpenAI.
OPENAI_TEXT_PROVIDER=auto
# Optional GPT text gateway. Keep OPENAI_API_KEY for direct calls and image moderation.
# OPENAI_BASE_URL=https://apikey.vnaipro.app/v1
OPENAI_BASE_URL=
OPENAI_TEXT_API_KEY=
OPENAI_IMAGE_PROVIDER=auto
# GPT Image inherits OPENAI_BASE_URL unless this is specified separately.
OPENAI_IMAGE_BASE_URL=
OPENAI_IMAGE_API_KEY=
# Optional official image key for direct mode; defaults to OPENAI_API_KEY.
OPENAI_IMAGE_DIRECT_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=medium
# Per-operation reasoning: low | medium | high. Common setting is the fallback.
OPENAI_CHAT_REASONING_EFFORT=low
OPENAI_NOVEL_WRITE_REASONING_EFFORT=low
OPENAI_NOVEL_PLAN_REASONING_EFFORT=medium
# WRITE also controls rewrites and the optional integrated generation call.
# Legacy fallback for novel planning/writing when their own setting is absent.
# OPENAI_NOVEL_REASONING_EFFORT=medium
OPENAI_NOVEL_REVIEW_REASONING_EFFORT=low
OPENAI_IMAGE_DESCRIPTION_REASONING_EFFORT=low
OPENAI_NOVEL_REVIEW_MAX_OUTPUT_TOKENS=12000
OPENAI_NOVEL_PLAN_MAX_OUTPUT_TOKENS=12000
# reviewed keeps independent review (default); integrated is an opt-in speed experiment.
OPENAI_NOVEL_GENERATION_MODE=reviewed
# Optional Gemini prose and rewrites, with separate OpenAI planning/review. Blank uses OpenAI.
# Example: GEMINI_NOVEL_WRITE_MODEL=gemini-3.5-flash-lite
GEMINI_NOVEL_WRITE_MODEL=
# Optional Korean copyedit after plot approval. Set to gemini-3.5-flash-lite to enable.
GEMINI_NOVEL_PROOFREAD_MODEL=
GEMINI_API_KEY=
# auto preserves base-URL routing. direct uses a Google-issued key below.
GEMINI_PROVIDER=auto
GEMINI_DIRECT_API_KEY=
# Optional OpenAI-compatible Gemini gateway base, for example https://apikey.vnaipro.app/v1
GEMINI_BASE_URL=
# Server review diagnostics: off | summary | full (default: summary).
# full includes manuscripts; use locally when comparing draft/rewrite/final output.
NOVEL_REVIEW_LOG_LEVEL=summary
OPENAI_NOVEL_INTEGRATED_MAX_OUTPUT_TOKENS=12000
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_QUALITY=medium

# Enable both flags only AFTER applying supabase/migrations and configuring Google OAuth.
ACCOUNT_FEATURES_ENABLED=false
NEXT_PUBLIC_ACCOUNT_FEATURES_ENABLED=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Mobile build uses this HTTPS Next API base. Empty keeps web same-origin.
NEXT_PUBLIC_API_BASE_URL=
VITE_API_BASE_URL=
MOBILE_ALLOWED_ORIGINS=https://localhost,http://127.0.0.1:5173
# Google Play one-time products (all four products, including the 30-day pass).
GOOGLE_PLAY_BILLING_ENABLED=false
GOOGLE_PLAY_PACKAGE_NAME=com.oestewdio.maite
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLAY_PRIVATE_KEY=
# Configure a rewarded ad unit with 5 hearts and this backend's /api/ads/ssv URL.
ADMOB_REWARDS_ENABLED=false
ADMOB_REWARDED_UNIT_ID=
NEXT_PUBLIC_ADMOB_REWARDED_ID=
NEXT_PUBLIC_ADMOB_TESTING=true

# Android check-ins use local one-shot notifications. No Firebase or cron secrets are required.
